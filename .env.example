APP_NAME="Engine Oil Inventory"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=engine_oil_inventory
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Order confirmations, payment decisions, delivery notices, email
# verification and password resets all go out through here.
#
# Left as it is, mail fails and is logged rather than thrown -- an order
# still completes, it just goes unannounced. Fill it in to receive mail.
#
# For Gmail: turn on 2-Step Verification on the account, then create an
# App Password (16 characters, no spaces) at
# https://myaccount.google.com/apppasswords and use that as MAIL_PASSWORD.
# An ordinary Gmail password will not work.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="your-shop@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# The shop assistant has two halves. Without a key it matches keywords
# against the answers in Admin -> Assistant and reads figures from the
# database. With a key, Groq answers instead, holding those same answers,
# the catalogue arranged by viscosity grade, and the vehicle table as its
# facts -- which is what lets it say whether a given car suits a given oil
# on the shelf. Orders, balances, prices and stock are still read from the
# database either way.
#
# Leave it empty and nothing changes, which is also what happens when there
# is no internet.
#
# Free, no card: https://console.groq.com/keys
# `php artisan assistant:check` says whether it works, and lists the models
# this key can reach if the one below has been retired.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional. Speeds up the gpt-oss models noticeably; other models refuse the
# field outright, so leave it blank unless you are on gpt-oss.
GROQ_REASONING_EFFORT=

# Contact and GCash number shown to customers. The default in
# config/business.php is the real one; set this only to override it.
BUSINESS_PHONE=

# Google Sign-In. Set false to hide the button and close the route without
# removing the credentials -- which is what a demonstration over a tunnel
# needs, since Google will not accept a public-suffix address such as an
# ngrok subdomain as an authorised domain.
GOOGLE_SIGNIN_ENABLED=true

# From https://console.cloud.google.com/auth/clients -- create an OAuth 2.0
# Client ID of type "Web application".
#
# Register every address the site is reached on as an Authorised redirect
# URI, each ending /auth/google/callback, for example
#     http://localhost:8123/auth/google/callback
# Google matches it character for character and refuses anything else, so a
# different port is a different URI and has to be registered too.
#
# Leave GOOGLE_REDIRECT_URI empty unless you want the callback pinned to one
# fixed address: empty means it is built from whichever address the visitor
# actually arrived on, which is right on localhost and over a tunnel alike.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# The Google Form the survey landing page at /survey links to.
SURVEY_FORM_URL=
